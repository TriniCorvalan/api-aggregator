FROM ruby:3.4.8

WORKDIR /app

# Dependencias de sistema para gems comunes (pg, etc.)
RUN apt-get update -qq && \
  apt-get install --no-install-recommends -y \
  build-essential \
  git \
  libpq-dev \
  libvips \
  pkg-config && \
  rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

# Instalar Rails (ajusta versión si quieres otra)
RUN gem install rails -v "~> 7.1"

# Bundler (Rails requiere bundler; dejamos que compose ejecute bundle install)
ENV BUNDLE_PATH="/usr/local/bundle"

EXPOSE 3000